generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum HabitFrecuencia {
  daily
  weekly
  monthly
  custom
}

enum HabitPrioridad {
  baja
  media
  alta
}

model User {
  id       String   @id @default(uuid()) @map("_id")
  nombre        String
  correo        String   @unique
  contraseña    String
  salt          String
  fechaRegistro DateTime @default(now())
  habits        Habit[]
  records       Record[]
}

model Habit {
  id                String            @id @default(uuid()) @map("_id")
  nombre            String
  descripcion       String?
  categoria         String?
  frecuencia        HabitFrecuencia
  prioridad         HabitPrioridad
  fechaInicio       DateTime
  fechaFin          DateTime?
  activo            Boolean           @default(true)
  eliminado         Boolean           @default(false)
  esCuantificable   Boolean           @default(true)
  cantidadObjetivo  Float?
  unidadObjetivo    String?
  usuarioId         String
  usuario           User              @relation(fields: [usuarioId], references: [id])
  records           Record[]
}

model Record {
  id          String   @id @default(uuid()) @map("_id")
  habitoId    String
  habito      Habit    @relation(fields: [habitoId], references: [id])
  usuarioId   String
  usuario     User     @relation(fields: [usuarioId], references: [id])
  fecha       DateTime
  completado  Boolean  @default(true)
  cantidad    Float?
}